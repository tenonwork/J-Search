# J-Search local configuration.
# Copy this file to `.env` and fill in one provider block.
# `.env` is gitignored. Real environment variables override these values.

# --- Cloudflare Workers AI (recommended) ---------------------------------
# Free allocation: 10,000 Neurons/day. Zero retention for standard inference,
# and Cloudflare does not train on customer content.
# Account ID: Cloudflare dashboard -> Workers & Pages -> Overview.
# API token: My Profile -> API Tokens -> Account -> Workers AI -> Read.
JSEARCH_LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
JSEARCH_LLM_MODEL=@cf/openai/gpt-oss-20b
JSEARCH_LLM_API_KEY=<CLOUDFLARE_API_TOKEN>
JSEARCH_LLM_TIMEOUT=120

# --- Groq (fast, very cheap) ----------------------------------------------
# JSEARCH_LLM_BASE_URL=https://api.groq.com/openai/v1
# JSEARCH_LLM_MODEL=openai/gpt-oss-20b
# JSEARCH_LLM_API_KEY=<GROQ_API_KEY>
# JSEARCH_LLM_TIMEOUT=90

# --- OpenRouter (many models; check each model's data policy) --------------
# JSEARCH_LLM_BASE_URL=https://openrouter.ai/api/v1
# JSEARCH_LLM_MODEL=<provider/model>
# JSEARCH_LLM_API_KEY=<OPENROUTER_API_KEY>

# --- Local Ollama (default when no .env is present) ------------------------
# JSEARCH_LLM_BASE_URL=http://127.0.0.1:11434/v1
# JSEARCH_LLM_MODEL=qwen2.5:7b-instruct
# JSEARCH_LLM_API_KEY=

# Optional: bind the dashboard to another interface (default is 127.0.0.1).
# JSEARCH_HOST=127.0.0.1
